<?xml version="1.0"?>
<package format="2">
  <name>event_guide_robot</name>
  <version>0.1.0</version>
  <description>Semantic event guide behavior for TurtleBot3 Waffle in ROS 1.</description>

  <maintainer email="event-guide-robot@example.com">Event Guide Robot Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>move_base_msgs</depend>
  <depend>actionlib</depend>
  <depend>cv_bridge</depend>

  <exec_depend>amcl</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot3_navigation</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
  </export>
</package>
